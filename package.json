{
  "name": "@eduwork/dsh-ecnu-open-data",
  "version": "0.1.0",
  "description": "Read-only access to the ECNU open-data platform: personnel, student and staff profiles, positions and an allowlisted query tool, with client-credentials and university SSO login.",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./core": "./lib/core.js",
    "./auth": "./lib/auth.js"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSING.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ecnu",
    "open-data",
    "oauth2",
    "campus"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
